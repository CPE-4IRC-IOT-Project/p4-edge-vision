build esp-idf/main/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/valentine/CPE_LYON/S8/Projet_IOT/esp-dev-kits/examples/esp32-p4-eye/examples/factory_demo/build_p4/esp-idf/main && /usr/bin/cmake --regenerate-during-build -S/home/valentine/CPE_LYON/S8/Projet_IOT/esp-dev-kits/examples/esp32-p4-eye/examples/factory_demo -B/home/valentine/CPE_LYON/S8/Projet_IOT/esp-dev-kits/examples/esp32-p4-eye/examples/factory_demo/build_p4
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build esp-idf/main/rebuild_cache: phony esp-idf/main/CMakeFiles/rebuild_cache.util


