  COMMAND = cd /home/valentine/CPE_LYON/S8/Projet_IOT/esp-dev-kits/examples/esp32-p4-eye/examples/factory_demo/build_p4/esp-idf/hal && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
